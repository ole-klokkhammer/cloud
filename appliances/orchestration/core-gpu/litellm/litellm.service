[Unit]
Description=LiteLLM Proxy (Anthropic API -> llama.cpp)
After=network.target llama-server.service

[Service]
Type=simple
User=root
Environment=OPENAI_API_KEY=sk-dummy
ExecStart=/opt/litellm/venv/bin/litellm \
      --model openai/qwen3-coder-next \
      --api_base http://localhost:8080/v1 \
      --host 0.0.0.0 \
      --port 4000 \
      --request_timeout 600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
