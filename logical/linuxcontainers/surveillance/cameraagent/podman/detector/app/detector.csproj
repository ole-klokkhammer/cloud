<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>detector</AssemblyName>
    <RootNamespace>Detector</RootNamespace>
    <!-- keep the OS TimeZone aware (tzdata in the image + TZ env in the quadlet)
         so stills are named in local time, like the old python detector -->
  </PropertyGroup>

  <ItemGroup>
    <!-- ONNX Runtime GPU: CUDA + TensorRT providers, bundled CUDA runtime
         (linux-x64 nuget; only the LXC's driver is shared, via CDI) -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.28.0" />
    <!-- NATS .NET client (the LXC's nats service; fire-and-forget publish) -->
    <PackageReference Include="nats.net" Version="3.2.0" />
    <!-- JPEG stills from raw BGR24 buffers (pure managed, no native deps) -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

</Project>
