[Unit]
Description=Camera object detector
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Container]
Network=host
ContainerName=detector 

Pull=newer
Image=registry.linole.org/detector:latest

# driver-only GPU: the torch wheel carries its CUDA runtime, nothing else to mount
AddDevice=nvidia.com/gpu=all

Volume=/config/detector:/config:rw
Volume=/media/detector:/detector:rw
Volume=/models:/models:ro

Environment=YOLO_CONFIG_DIR=/config
EnvironmentFile=/env/detector.env
Environment=TZ=Europe/Oslo


[Service]
Restart=always
RestartSec=5
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
