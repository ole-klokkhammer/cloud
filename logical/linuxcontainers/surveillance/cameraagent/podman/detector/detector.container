[Unit]
Description=Camera object detector
After=network-online.target triton.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Container]
Network=host
ContainerName=detector

Pull=newer
Image=registry.linole.org/surveillance/detector:latest

# inference runs in the triton container - this one is CPU-only
Volume=/config/detector:/config:rw
Volume=/media/detector:/detector:rw

Environment=TZ=Europe/Oslo

Environment=RTSP_URL=rtsp://mediamtx.homelan:8554/entrance_roof

Environment=TRITON_URL=127.0.0.1:8001
Environment=TRITON_MODEL=yolo26x
Environment=TRITON_CLASS_FILTER=0,2,15,14,16,25,26,24,39,67,41,45,78,48,53
Environment=TRITON_INPUT_SIZE=640
Environment=TRITON_MIN_CONF=0.5
Environment=TRITON_IOU=0.45

Environment=DETECTOR_MAX_FPS=5
Environment=DETECTOR_BURST_WINDOW_SECS=2.0

Environment=EVENT_CAMERA_NAME=entrance_roof
Environment=EVENT_FRAME_WIDTH=2560
Environment=EVENT_DIR=/detector/events

Environment=MQTT_HOST=hivemq.homelan
Environment=MQTT_PORT=1883
Environment=MQTT_TOPIC=surveillance/detector 


[Service]
Restart=always
RestartSec=5
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
