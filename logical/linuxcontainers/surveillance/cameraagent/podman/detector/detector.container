[Unit]
Description=Camera object detector
After=network-online.target triton.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Container]
Network=host
ContainerName=detector

Pull=newer
Image=registry.linole.org/surveillance/detector:latest

# inference runs in the triton container - this one is CPU-only
Volume=/config/detector:/config:rw
Volume=/media/detector:/detector:rw

Environment=TZ=Europe/Oslo
Environment=DETECTOR_RTSP_URL=rtsp://mediamtx.homelan:8554/entrance_roof
Environment=DETECTOR_MODEL=/models/rtdetr-x.pt
Environment=DETECTOR_CLASS=0,2,15,14,16,25,26,24,39,67,41,45,78,48,53
Environment=DETECTOR_FRAME_WIDTH=2560
Environment=DETECTOR_INPUT_SIZE=640
Environment=DETECTOR_MIN_CONF=0.5
Environment=DETECTOR_MAX_FPS=5
Environment=DETECTOR_BURST_WINDOW_SECS=2.0
Environment=DETECTOR_EVENT_DIR=/detector/events
Environment=DETECTOR_CAMERA=entrance_roof
Environment=DETECTOR_DEVICE=cuda
Environment=DETECTOR_TRITON_URL=127.0.0.1:8001
Environment=DETECTOR_TRITON_MODEL=yolo26x
Environment=MQTT_HOST=hivemq.homelan
Environment=MQTT_PORT=1883
Environment=MQTT_TOPIC=surveillance/detector 


[Service]
Restart=always
RestartSec=5
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
