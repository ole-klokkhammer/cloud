[Unit]
Description=Camera object detector (python/torch, CUDA YOLO11) - mediamtx RTSP
After=network-online.target

[Container]
Network=host
ContainerName=detector 

Pull=newer
Image=registry.linole.org/detector:latest
Exec=/app/detector.py

# driver-only GPU: the torch wheel carries its CUDA runtime, nothing else to mount
AddDevice=nvidia.com/gpu=all

Volume=/detections:/detections:rw
Volume=/models:/models:ro

EnvironmentFile=/env/surveillance/detector.env
Environment=TZ=Europe/Oslo

[Service]
Restart=always
RestartSec=5
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
