# detector (python/torch) environment - copy to the LXC as /env/surveillance/detector.env (never in git)

# mediamtx re-served SUB stream (cheap decode; main kept for recording/playback).
# Point at the main path (<...>/entrance_roof) if the substream is too low-res.
DETECTOR_RTSP_URL=rtsp://mediamtx.homelan:8554/entrance_roof_sub

# model: .pt in LXC /models (= host /ssd/llm/models/detector, LXD-mounted ro), shipped
# by 'make push-model' (ships yolo26m.pt). fine-tuned: train a .pt, make
# push-model, point here at /models/<file>.pt - no image rebuild
DETECTOR_MODEL=/models/yolo26m.pt

# COCO class id(s) to react to, comma-separated (15 = cat)
DETECTOR_CLASS=15

# stills wider than this get downscaled (decode happens at native substream res)
DETECTOR_FRAME_WIDTH=1280

# yolo inference input size (the model was trained at 640)
DETECTOR_INPUT_SIZE=640

# runtime confidence floor (NMS iou 0.45 is a fixed runtime arg in detector.py)
DETECTOR_MIN_CONF=0.5

# inference throttle (the stream itself is VFR ~2-10fps on motion)
DETECTOR_MAX_FPS=10

# burst close after this many seconds without a detection -> store best still + event
DETECTOR_BURST_WINDOW_SECS=2.0

# stills land on the host HDD (LXC /detections = /hdd/surveillance/detections)
DETECTOR_EVENT_DIR=/detector/events
DETECTOR_CAMERA=entrance_roof

# "cuda" or "cpu" (cpu to test without the GPU)
DETECTOR_DEVICE=cuda

# event bus (nats LXC, host network)
NATS_URL=nats://nats.homelan:4222
NATS_SUBJECT=surveillance.detector
