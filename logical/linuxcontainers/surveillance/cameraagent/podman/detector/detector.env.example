# detector (RTSP consumer + triton gRPC client) environment - copy to the
# LXC as /env/cameraagent/detector.env (never in git)

DETECTOR_RTSP_URL=rtsp://mediamtx.homelan:8554/entrance_roof

# model: baked into the image; point at a fine-tuned .onnx in /config/detector/
# to override - no image rebuild needed
DETECTOR_MODEL=/models/rtdetr-x.pt

# COCO class id(s) to react to, comma-separated (15 = cat)
DETECTOR_CLASS=0,2,15,14,16,25,26,24,39,67,41,45,78,48,53

# decode width -> still resolution (stills are 1280px wide, like the python detector)
DETECTOR_FRAME_WIDTH=2560

# ONNX input size - must equal the export imgsz
DETECTOR_INPUT_SIZE=640

# runtime confidence floor (NMS + iou are baked into the export; change = re-export)
DETECTOR_MIN_CONF=0.5

# inference throttle (the stream itself is VFR ~2-10fps on motion)
DETECTOR_MAX_FPS=5

# burst close after this many seconds without a detection -> store best still + event
DETECTOR_BURST_WINDOW_SECS=2.0

# stills land on the HDD pool (LXC /detector = core /hdd/surveillance/detector)
DETECTOR_EVENT_DIR=/detector/events
DETECTOR_CAMERA=entrance_roof

# "cuda" or "cpu" (cpu to test without the GPU)
DETECTOR_DEVICE=cuda

# event bus in this LXC (nats service, host network)
NATS_URL=nats://nats.homelan:4222
NATS_SUBJECT=surveillance.detector

# MQTT publisher (HiveMQ) - OFF unless MQTT_HOST is set.
# One topic per camera: <MQTT_TOPIC>/<DETECTOR_CAMERA>, i.e.
# surveillance/detector/entrance_roof. Bursts only, same payloads as NATS.
MQTT_HOST=hivemq.homelan
MQTT_PORT=1883
MQTT_TOPIC=surveillance/detector
# anonymous today (broker has no auth); fill in if HiveMQ gets auth
#MQTT_USER=
#MQTT_PASS=
