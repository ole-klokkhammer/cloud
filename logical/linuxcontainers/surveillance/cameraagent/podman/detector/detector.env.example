# detector (.NET/ONNX) environment - copy to the LXC as /env/surveillance/detector.env (never in git)

# mediamtx re-served SUB stream (cheap decode; main kept for recording/playback).
# Point at the main path (<...>/entrance_roof) if the substream is too low-res.
DETECTOR_RTSP_URL=rtsp://mediamtx.homelan:8554/entrance_roof_sub

# model: shipped to the LXC /models via 'make push-model' (mounted ro);
# fine-tuned .onnx: 'make push-model' again + point here at /models/<file>.onnx
DETECTOR_MODEL=/models/yolo11m.onnx

# COCO class id(s) to react to, comma-separated (15 = cat)
DETECTOR_CLASS=15

# decode width -> still resolution (stills are 1280px wide, like the python detector)
DETECTOR_FRAME_WIDTH=1280

# ONNX input size - must equal the export imgsz
DETECTOR_INPUT_SIZE=640

# runtime confidence floor (NMS + iou are baked into the export; change = re-export)
DETECTOR_MIN_CONF=0.5

# inference throttle (the stream itself is VFR ~2-10fps on motion)
DETECTOR_MAX_FPS=10

# burst close after this many seconds without a detection -> store best still + event
DETECTOR_BURST_WINDOW_SECS=2.0

# stills land on the HDD pool (LXC /detector = core /hdd/surveillance/detector)
DETECTOR_EVENT_DIR=/media/events
DETECTOR_CAMERA=entrance_roof

# "cuda" or "cpu" (cpu to test without the GPU)
DETECTOR_DEVICE=cuda

# event bus in this LXC (nats service, host network)
NATS_URL=nats://nats.homelan:4222
NATS_SUBJECT=surveillance.detector
