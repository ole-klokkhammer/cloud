
name: "rtdetr-x"
backend: "tensorrt"
default_model_filename: "model.plan"
max_batch_size: 0

input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [ 1, 3, 640, 640 ]
  }
]

output [
  {
    name: "output0"
    data_type: TYPE_FP32
    dims: [ 1, 300, 6 ]
  }
]

instance_group [
  {
    count: 1
    gpus: [ 0 ]
  }
]
# If it loads but inference dies with an "I/O tensor not contiguous"
# error, add:
# optimization [ { input_allow_random_max_strides: true } ]
