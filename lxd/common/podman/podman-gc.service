[Unit]
Description=Podman store GC (dangling image layers only)
After=local-fs.target

[Service]
Type=oneshot
# Dangling (untagged) image layers only - those are pure re-pull residue.
# Deliberately no -a / no "system prune": on a fleet, "unused" images/volumes
# include temporarily-stopped apps and data-bearing named volumes.
# -f is required for an unattended timer (no interactive prompt).
ExecStart=/usr/bin/podman image prune -f
# free space lands in the journal so you can see what it recovered:
ExecStart=/usr/bin/podman system df