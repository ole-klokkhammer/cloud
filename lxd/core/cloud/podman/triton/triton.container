[Unit]
Description=Surveillance triton inference server (YOLO model host)
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Container]
Network=host
ContainerName=triton

Pull=newer
Image=registry.linole.org/surveillance/triton:latest 
Exec=sh -c "tritonserver \
    --model-repository=/model_repository \
    --model-control-mode=explicit \
    --load-model=$ACTIVE_MODEL \
    --model-config-name=$CONFIG_PROFILE \
    --log-info=true"

AddDevice=nvidia.com/gpu=all

Volume=/models/yolo/yolo26x.plan:/model_repository/yolo26x/1/model.plan:ro
Volume=/models/yolo/rtdetr-x.plan:/model_repository/rtdetr-x/1/model.plan:ro

# -------------------------------------------------------------
# CONFIGURATION CHOICES (Change these to switch models/profiles)
# The profile MUST match the artifact mounted for that model dir:
#   rtdetr-x  (rtdetr-x.engine, trtexec-built in the image) -> tensorrt
#   yolo26x   (yolo26x.onnx)                                -> onnx
# Configs are baked into the image at model_repository/<model>/
# <profile>.pbtxt and selected by --model-config-name (tritonserver
# only reads model-level or version-level config - NOT configs/
# subfolders). Model files are the LXD mounts above.
# -------------------------------------------------------------
Environment=ACTIVE_MODEL=yolo26x
Environment=CONFIG_PROFILE=tensorrt
Environment=TZ=Europe/Oslo


[Service]
Restart=always
RestartSec=5
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
