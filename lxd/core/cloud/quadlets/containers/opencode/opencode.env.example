# Copy to core:cloud:/ssd/appdata/env/opencode.env (0600) - `make env` does it:
#
#   make env                                             # generated password
#   make env FORCE=1                                     # rotate
#   lxc file push opencode.env core:cloud/ssd/appdata/env/opencode.env   # by hand
#
# opencode turns these into HTTP basic auth on every route, including /tui (which
# drives the agent) and the SSE event streams. Both are required: with the
# password unset, auth is off. systemd reads this at exec time, so `make restart`
# after editing.
OPENCODE_SERVER_USERNAME=ole
OPENCODE_SERVER_PASSWORD=replace-me
