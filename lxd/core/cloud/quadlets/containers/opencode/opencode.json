{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local LLM (llm.linole.org)",
      "options": {
        "apiKey": "LOCAL_LLM_KEY",
        "baseURL": "https://llm.linole.org/v1",
        "timeout": false
      },
      "models": {
        "llm": {
          "name": "Qwen3.8-Flash-Next (NVFP4, local)",
          "family": "qwen",
          "tool_call": true,
          "reasoning": true,
          "temperature": true,
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": { "context": 230000, "output": 32000 },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 }
        }
      }
    }
  },
  "model": "local/llm",
  "mcp": {
    "servers": {
      "duckduckgo": {
        "type": "local",
        "command": ["duckduckgo-mcp-server"]
      }
    }
  }
}
