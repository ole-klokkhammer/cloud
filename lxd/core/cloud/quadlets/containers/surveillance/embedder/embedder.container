[Unit]
Description=Camera-still embedder (CLIP -> pgvector + NATS)
After=network-online.target detector.service nats.service
Wants=detector.service
Requires=nats.service

[Container]
Network=apps.network
ContainerName=embedder
Image=registry.linole.org/embedder:latest
AddDevice=nvidia.com/gpu=all

Volume=/ssd/models/surveillance/clip:/models:ro
Volume=/ssd/appdata/surveillance/embedder:/config/embedder:rw
Volume=/ssd/appdata/surveillance/detector:/detector:ro
Volume=/etc/localtime:/etc/localtime:ro

EnvironmentFile=/ssd/appdata/env/embedder.env
Environment=TZ=Europe/Oslo
Exec="python3 /app/embedder.py"

[Service]
Restart=always
RestartSec=5
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
