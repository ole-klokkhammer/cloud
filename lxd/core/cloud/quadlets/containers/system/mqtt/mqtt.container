[Unit]
Description=NanoMQ MQTT broker (fleet MQTT service)
After=network-online.target
RequiresMountsFor=/ssd/appdata/mqtt /ssd/appdata/env

[Container]
ContainerName=mqtt

Network=apps.network

DropCapability=ALL
NoNewPrivileges=true
ReadOnly=true 
Tmpfs=/tmp:rw,nosuid,nodev,mode=1777

EnvironmentFile=/ssd/appdata/env/nanomq.env

Image=docker.io/emqx/nanomq:latest

Volume=/ssd/appdata/mqtt/config/nanomq.conf:/usr/local/nanomq/nanomq.conf:ro
Volume=/ssd/appdata/mqtt/data:/var/lib/nanomq:rw
Volume=/etc/localtime:/etc/localtime:ro

[Service]
Restart=always
RestartSec=5
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
