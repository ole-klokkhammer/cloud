# Credential for NanoMQ's HTTP API (Basic auth).
#
# NanoMQ 0.25.7 reads API credentials from its config file only - the
# NANOMQ_HTTP_SERVER_* variables on the website's Docker page are not implemented
# in this release. So the broker's command line takes NANOMQ_API_PASSWORD from
# this file (podman --env-file) and substitutes it into the @API_PASSWORD@
# placeholder in config/nanomq.conf before starting. Unset or empty makes the
# container fail loudly instead of serving a blank password.
#
# `make deploy` installs this to /ssd/appdata/env/nanomq.env the first time and
# never overwrites it. To change it:
#
#   lxc exec core:cloud -- sh -c "cat /ssd/appdata/env/nanomq.env"
#   lxc exec core:cloud -- sh -c "cat > /ssd/appdata/env/nanomq.env" < /tmp/nanomq.env
#   make restart
#
# The username is fixed as "admin" in config/nanomq.conf; edit it there.
# Avoid these characters in the password: | & \ backtick $ (sed delimiter and
# shell expansion in the render step).
#
# Location matches the other cloud services' secrets (embedder.env,
# surveillance/query.env): the env dataset, not this service's appdata.
NANOMQ_API_PASSWORD=change-me
