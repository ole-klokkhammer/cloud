[Unit]
Description=Traefik Edge Router
After=network-online.target
RequiresMountsFor=/ssd/appdata/traefik/dynamic

[Container]
ContainerName=traefik
#UserNS=auto

Network=apps.network
PublishPort=80:80
PublishPort=443:443

DropCapability=ALL
AddCapability=NET_BIND_SERVICE
NoNewPrivileges=true
ReadOnly=true

Image=docker.io/library/traefik:v3.7
Exec=--api.insecure=true \
    --api.dashboard=true \
    --providers.file.directory=/etc/traefik/dynamic \
    --entrypoints.web.address=:80 \
    --entrypoints.websecure.address=:443 \
    --providers.file.watch=true \
    --log.level=INFO

# manual route files; drop a .yaml/.json in and it hot-reloads (inotify)
Volume=/ssd/appdata/traefik/dynamic:/etc/traefik/dynamic:ro

[Service]
Restart=on-failure

[Install]
WantedBy=multi-user.target