[Unit]
Description=Infernix Service (Wallawalla47 Qwen3.8-Flash-Next NVFP4 Dense8 + DFlash2 drafter)
After=network-online.target

[Container]
Network=host
ContainerName=infernix
AddDevice=nvidia.com/gpu=all
ShmSize=32g

Volume=/models:/models:ro
Volume=/cache:/cache:rw
Volume=/usr/bin/numactl:/usr/bin/numactl:ro

Environment=INFERNIX_CUDA_SYNC=blocking

Image=registry.linole.org/infernix:latest
Exec=sh -c 'numactl --interleave=all infernix-serve \
    /models/qwen3.8/wallawalla47_Qwen3.8-Flash-Next-NVIDIA-NVFP4-Dense8-Infernix/Qwen3.8-Flash-Next-NVIDIA-NVFP4-Dense8-Infernix-00001-of-00003.infernix \
    --ngram-volume /models/qwen3.8/wallawalla47_Qwen3.8-Flash-Next-NVIDIA-NVFP4-Dense8-Infernix/Qwen3.8-Flash-Next-NVIDIA-NVFP4-Infernix.ngram \
    --prefix-cache-file /cache/qwen3.8-flash-next.cache \
    --expert-state /cache/qwen3.8-flash-next.expert-state \
    --chat-template /models/qwen3.8/wallawalla47_Qwen3.8-Flash-Next-NVIDIA-NVFP4-Dense8-Infernix/chat_template.jinja \
    --tolerant-tool-calls \
    --host-context-mib 16384 \
    --max-context 262144 \
    --kv-dtype fp8 \
    --draft-model /models/qwen3.8/wallawalla47_Qwen3.8-Flash-Next-DFlash2-Infernix/Qwen3.8-Flash-Next-DFlash2-Infernix.infernix \
    --spec dflash2 \
    --draft-tokens auto \
    --lm-head-draft \
    --max-concurrency 2 \
    --vision \
    --vision-max-merged 32768 \
    --vision-offload on \
    --model-id "llm" \
    --host 0.0.0.0 \
    --port 8000 \
    --log-level debug \
    2>&1'

[Service]
Restart=always
TimeoutStopSec=600
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
