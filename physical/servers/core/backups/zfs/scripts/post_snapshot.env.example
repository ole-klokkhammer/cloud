# /etc/sanoid/sanoid-s3.env
# Shared environment variables for sanoid S3 hooks (post_snapshot + pruning)

# S3 destination
S3_BUCKET="zfs-core"
AWS_PROFILE="zfs-core"
S3_ENDPOINT_URL="https://j8t7.ldn203.idrivee2-94.com"

# Optional: Webhook URL for notifications (Matrix, Slack, Discord, ntfy, etc.)
# The webhook receives a JSON POST with {"status": "ok|error", "message": "..."}
# WEBHOOK_URL="http://your-webhook-endpoint/notify"

# Incremental backup policy: which snapshot types trigger a FULL backup
# Default: weekly,monthly,yearly (daily/hourly get incremental backups)
FULL_SNAPSHOT_TYPES="weekly,monthly,yearly"

# Log file location (used by both scripts)
LOG_FILE="/var/log/sanoid/sanoid-s3.log"
