[Unit]
Description=Home Assistant
After=network.target

[Service]
Type=simple
User=homeassistant
EnvironmentFile=/secrets/homeassistant.env
WorkingDirectory=/home/homeassistant/homeassistant
ExecStart=/home/homeassistant/homeassistant/bin/python /home/homeassistant/homeassistant/bin/hass --config /config
Restart=always

[Install]
WantedBy=multi-user.target
